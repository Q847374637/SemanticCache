<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>SemanticCache.Ollama</PackageId>
    <Version>1.0.0</Version>
    <Authors>Q847374637</Authors>
    <Description>Local Ollama embedding provider for SemanticCache.Core. Run high-performance semantic caching locally without API costs.</Description>
    <PackageTags>semantic-cache;ollama;vector-search;llm;ai;embeddings;rag;local</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/Q847374637/SemanticCache.Core</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticCache.Core\SemanticCache.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>