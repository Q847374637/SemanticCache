<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>SemanticCache.OpenAI</PackageId>
    <Version>1.0.0</Version>
    <Authors>Q847374637</Authors>
    <Description>OpenAI embedding provider for SemanticCache.Core. Enables seamless integration with OpenAI embedding models for local semantic caching.</Description>
    <PackageTags>semantic-cache;openai;vector-search;llm;ai;embeddings;rag</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/Q847374637/SemanticCache.Core</RepositoryUrl> 
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticCache.Core\SemanticCache.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>